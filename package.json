{
  "name": "verdict",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "simulate": "node scripts/simulate.mjs",
    "lab": "node scripts/lab.mjs",
    "release": "node scripts/lab.mjs snapshot && node scripts/report.mjs && pnpm ship",
    "ship": "pnpm build && wrangler deploy",
    "e2e": "node scripts/e2e.mjs",
    "report": "node scripts/report.mjs",
    "shots": "node scripts/shots.mjs",
    "record": "node scripts/record.mjs",
    "roughcut": "node scripts/record.mjs && node scripts/roughcut.mjs"
  },
  "dependencies": {
    "@flagsmith/flagsmith": "12.5.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@flagsmith/nodejs": "9.4.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.0.5",
    "wrangler": "4.165.0"
  }
}
